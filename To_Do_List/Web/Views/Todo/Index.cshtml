@model IEnumerable<To_Do_List.Web.ViewModels.TodoIndexViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Danh sách công việc</h2>
    <a asp-controller="Todo" asp-action="Create" class="btn btn-success">Thêm mới</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Tiêu đề</th>
            <th>Mô tả</th>
            <th>Hạn chót</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.DueDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @(item.IsCompleted ? "Đã xong" : "Chưa xong")
                </td>
            </tr>
        }
    </tbody>
</table>
